{
  "name": "@squaredlemons/canvas-panels",
  "version": "0.4.0",
  "description": "Canvas Panel Stack UI for React 19 and Next.js: typed panel navigation, guarded unsaved-changes transitions, deep-linkable URL state, and accessible region cycling",
  "keywords": [
    "canvas",
    "panels",
    "panel-stack",
    "master-detail",
    "drill-down",
    "react",
    "react-19",
    "nextjs",
    "navigation",
    "deep-linking",
    "unsaved-changes",
    "accessibility",
    "ui",
    "typescript"
  ],
  "license": "MIT",
  "author": "Squared Lemons Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Squared-Lemons-Ltd/canvas-panels.git",
    "directory": "packages/canvas-panels"
  },
  "homepage": "https://github.com/Squared-Lemons-Ltd/canvas-panels#readme",
  "bugs": "https://github.com/Squared-Lemons-Ltd/canvas-panels/issues",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "import": "./dist/next/server.js"
    },
    "./extensions/editor": {
      "types": "./dist/extensions/editor.d.ts",
      "import": "./dist/extensions/editor.js"
    },
    "./extensions/resources": {
      "types": "./dist/extensions/resources.d.ts",
      "import": "./dist/extensions/resources.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "peerDependencies": {
    "next": ">=15 <17",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
