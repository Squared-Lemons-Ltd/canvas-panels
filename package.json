{
  "name": "canvas-panels-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @squaredlemons/canvas-panels build && pnpm --filter './apps/**' build",
    "format:check": "biome format .",
    "lint": "biome lint . && node scripts/check-boundaries.mjs",
    "test": "node --test tests/dependency-boundaries.test.mjs tests/package-contract.test.mjs",
    "typecheck": "pnpm --filter @squaredlemons/canvas-panels build && pnpm -r typecheck",
    "pack:check": "node --test tests/packed-consumers.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "typescript": "5.9.3"
  }
}
